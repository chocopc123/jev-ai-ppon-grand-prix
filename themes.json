{
  "themes": [
    {
      "id": 1,
      "text": "こんなコンビニは嫌だ。どんなの？"
    },
    {
      "id": 2,
      "text": "写真で一言"
    },
    {
      "id": 3,
      "text": "誰も聞いたことのない足音の擬音"
    },
    {
      "id": 4,
      "text": "先生、実は〜んです"
    },
    {
      "id": 5,
      "text": "こんな旅館は嫌だ。どんなの？"
    },
    {
      "id": 6,
      "text": "独身最後の晩餐、メニューはこれだ"
    },
    {
      "id": 7,
      "text": "初めてガンダムに乗った時の最初の一言"
    },
    {
      "id": 8,
      "text": "世界一かっこいい駅のホームのアナウンス"
    },
    {
      "id": 9,
      "text": "あまりにも役に立たない防災グッズ"
    },
    {
      "id": 10,
      "text": "未来のコンビニおでんに入っていそうな具"
    },
    {
      "id": 11,
      "text": "こんなアプリは嫌だ。どんなの？"
    },
    {
      "id": 12,
      "text": "上司にメールで『了解』と送るとこうなる"
    },
    {
      "id": 13,
      "text": "オセロの石でできた将棋の駒、その名前"
    },
    {
      "id": 14,
      "text": "プロレスラーが改善提案してそうな会議"
    },
    {
      "id": 15,
      "text": "おすすめされると逆に買わなくなるもの"
    },
    {
      "id": 16,
      "text": "温泉の効能書きに書いてそうで書いていないこと"
    },
    {
      "id": 17,
      "text": "AIが聞いてきそうな夜中のヒルナンデス"
    },
    {
      "id": 18,
      "text": "こんな天気予報は嫌だ。どんなの？"
    },
    {
      "id": 19,
      "text": "初めてスーパーのレジ打ちをした宇宙人の一言"
    },
    {
      "id": 20,
      "text": "大喜利の採点が厳しすぎる時の言い訳"
    },
    {
      "id": 21,
      "text": "バイクに乗せたら絶対に嫌な同乗者"
    },
    {
      "id": 22,
      "text": "家庭菜園で収穫したらまず野生動物が一言"
    },
    {
      "id": 23,
      "text": "ゲーム実況者が絶対に言わない一言"
    },
    {
      "id": 24,
      "text": "エレベーターの閉ボタンの上に書いてある嘘"
    }
  ]
}