# TypeSafe AI API Key (apikey_...)
TYPESAFE_API_KEY=
# (Optional) OpenRouter API Key (sk-or-v1-...) - fallback
OPENROUTER_API_KEY=

# Jev Model Identifier (default: jev-latest)
JEV_MODEL=jev-latest

# Game Settings
THEME_TIME_LIMIT=150
TARGET_IPPON=3

# Google Gemini API Key (for theme generation & Gemini TTS audio)
GEMINI_API_KEY=

# Theme Generation Model (default: gemini-flash-lite-latest)
GEMINI_THEME_MODEL=gemini-flash-lite-latest

# Discord Activities (Embedded App SDK)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

